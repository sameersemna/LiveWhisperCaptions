WHISPER_HOST="192.168.178.55:8768"
# Linux: any PulseAudio/PipeWire source name (a bluez_source.* HFP source for
# Bluetooth, a *.monitor to capture what a sink is playing, a real mic name...).
# macOS: an avfoundation device index or exact device name instead.
# Run `./call-transcribe-live.sh --list-devices` to see the options and their
# current capture volume. See CLAUDE.md.
#
# "auto" — or a name that no longer exists — makes call-transcribe-live.sh
# resolve a source itself (an existing BT_SOURCE if there is one, otherwise the
# default sink's monitor) and say which it picked. Note a monitor carries the
# *other* party of a call, not your own voice; point this at a microphone if you
# want your own side. The script also compensates the chosen source's volume
# back to unity, so a device the OS left turned down no longer reads as silence.
BT_SOURCE="auto"
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_URL="http://192.168.178.55:11434"
TRANSLATE_MODE="cloud"
